{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "Kestrel": {
    "Endpoints": {
        "WebApi": {
            "Url": "http://0.0.0.0:5001",
            "Protocols": "Http1"
        },
        "gRPC": {
            "Url": "http://0.0.0.0:6000",
            "Protocols": "Http2"
        }
    }
  },
  "AllowedHosts": "*",
  "JWT" : {
    "Key": "#{JWTKEY}",
    "Issuer": "#{ISSUER}",
    "Admin": "#{HASHPASS}"
  }
}
